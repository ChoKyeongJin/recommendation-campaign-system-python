      "sql": "SELECT DISTINCT B.MEMBER_NO AS CUST_ID, B.EMART_GRADE_CD AS member_grade, '20260701~20260731 회원 월별 스냅샷 있음' AS segment_label\nFROM CRM_MB_BASEINFO B\nWHERE B.MEMBER_STATE_CD = 'MEMBER_STATE_CD.NORMAL'\n  AND EXISTS (SELECT 1 FROM CRM_MB_MONTHCRMINFO MS WHERE MS.MEMBER_NO = B.MEMBER_NO AND (MS.YYYYMM >= '202607' AND MS.YYYYMM < '202608') AND (MS.ZTS_GRADE = 'MEM_GRADE_CD.GOLD'))"
