{
  "version": 1,
  "description": "조건 소유권 정책 — 여러 파서가 같은 사용자 조건을 병행 해석했을 때 어느 IR 슬롯이 canonical owner 인지, 비권위 파서(집합식)의 중복 후보를 어떻게 억제할지, 최종 clarification 을 언제 발생시킬지 선언한다. condition_reconciliation.py 가 이 파일만 읽어 동작하며 슬롯 이름/우선순위/매칭 임계는 코드가 아니라 여기서 바꾼다.",

  "ownership": {
    "description": "tier 우선순위(앞이 강함). owners[].tier 가 여기 이름을 가리킨다. 같은 조건을 두 슬롯이 주장하면 앞선 tier 가 canonical owner 가 된다.",
    "priority": [
      "event_expression",
      "explicit_filters",
      "exclude",
      "include",
      "dimension_filters",
      "entity_set",
      "set_expressions"
    ]
  },

  "owners": {
    "event_expression": {
      "tier": "event_expression",
      "authoritative": true,
      "path": "event_expression",
      "shape": "object",
      "semantic_domain": "event",
      "semantic_attribute": "boolean_expression",
      "polarity": "unknown",
      "trust_polarity": false,
      "description": "근거 span과 Boolean topology를 보존한 Event IR 후보. 같은 원문 operand의 legacy/Set 후보보다 우선한다.",
      "fields": {
        "text": ["source_text"],
        "spans": ["evidence_span"]
      }
    },
    "exclude.gender": {
      "tier": "exclude",
      "authoritative": true,
      "path": "exclude.gender",
      "shape": "value_list",
      "semantic_domain": "member",
      "semantic_attribute": "gender",
      "polarity": "exclude"
    },
    "exclude.lifecycle": {
      "tier": "exclude",
      "authoritative": true,
      "path": "exclude.lifecycle",
      "shape": "value_list",
      "semantic_domain": "member",
      "semantic_attribute": "lifecycle",
      "polarity": "exclude"
    },
    "exclude.interests": {
      "tier": "exclude",
      "authoritative": true,
      "path": "exclude.interests",
      "shape": "value_list",
      "semantic_domain": "member",
      "semantic_attribute": "interests",
      "polarity": "exclude"
    },
    "target_user.gender": {
      "tier": "include",
      "authoritative": true,
      "path": "target_user.gender",
      "shape": "value",
      "semantic_domain": "member",
      "semantic_attribute": "gender",
      "polarity": "include"
    },
    "target_user.lifecycle": {
      "tier": "include",
      "authoritative": true,
      "path": "target_user.lifecycle",
      "shape": "value_list",
      "semantic_domain": "member",
      "semantic_attribute": "lifecycle",
      "polarity": "include"
    },
    "dimension_filters": {
      "tier": "dimension_filters",
      "authoritative": true,
      "path": "dimension_filters",
      "shape": "object_list",
      "semantic_domain": "member",
      "description": "실DB 컬럼까지 매핑된 값 필터. attribute 는 컬럼명 마지막 조각(SIDO 등)으로 파생한다.",
      "attribute_transform": "last_path_segment_lower",
      "fields": {
        "attribute": "column",
        "values": ["names", "codes"],
        "polarity": "polarity",
        "operator": "operator",
        "text": ["evidence"],
        "spans": ["value_spans"]
      }
    },
    "target_user.entity_set_condition": {
      "tier": "entity_set",
      "authoritative": true,
      "path": "target_user.entity_set_condition",
      "shape": "object",
      "semantic_domain": "entity_relation",
      "semantic_attribute": "entity_set",
      "polarity": "include",
      "description": "파생 엔터티 집합(상위 N개 상품 구매 등). 미지원 사유가 붙으면 소유권을 주장하지 않는다(그 조건은 여전히 미해결).",
      "authoritative_when": {"unsupported_reason": null},
      "fields": {
        "text": ["ko_label"],
        "spans": ["spans.clause"]
      }
    },
    "set_expressions": {
      "tier": "set_expressions",
      "authoritative": false,
      "fallback_only": true,
      "trust_polarity": false,
      "path": "set_expressions",
      "shape": "set_expressions",
      "description": "일반 집합식 파서. 전용 슬롯이 해석하지 못한 진짜 집합 연산만 소유한다. 자체 극성(차집합 좌/우)은 신뢰하지 않는다 — 재작성문에서 자주 뒤집힌다."
    }
  },

  "suppression": {
    "set_expression_operands": {
      "enabled": true,
      "suppress_when_owned_by_authoritative_slot": true,
      "suppress_unknown_when_source_is_consumed": true,
      "suppress_operator_when_all_operands_are_consumed": true,
      "retain_unconsumed_operands": true,
      "union_operands_require_same_owner": true,
      "union_same_owner_required_polarities": ["include"],
      "union_rule_description": "긍정 문맥의 합집합(OR)은 소유 슬롯들이 AND 로 결합되므로 개별 operand 를 지우면 의미가 좁아진다 — 하위 전부가 '같은 소유 인스턴스'(예: 같은 dimension_filter 의 IN 목록)일 때만 통째로 소유된 것으로 본다. 부정 문맥의 합집합('A 또는 B 를 제외')은 드모르간으로 각 제외의 AND 와 같아 개별 억제가 안전하므로 이 보호를 적용하지 않는다.",
      "annotate_operands": true
    }
  },

  "matching": {
    "methods": ["source_span", "semantic_fingerprint", "normalized_text"],
    "source_span": {
      "enabled": true,
      "minimum_overlap_ratio": 0.6,
      "overlap_basis": "shorter"
    },
    "normalized_text": {
      "enabled": true,
      "minimum_overlap_ratio": 0.6,
      "allow_value_only_match": true,
      "valueless_owner": {
        "require_explicit_span": true,
        "minimum_overlap_ratio": 0.8,
        "description": "값 없이 표면 어구만 가진 소유자(파생 엔터티 집합 등)는 흔한 명사 겹침만으로 과매칭되기 쉽다. 명시적 source span 을 가진 소유자에게만, 더 높은 토큰 겹침으로 소유를 인정한다 — 근거가 없으면 소유를 주장하지 않고 미해결로 남긴다."
      },
      "ignore_tokens": [
        "고객", "회원", "사용자", "사람", "세그먼트", "집합", "그룹", "대상",
        "중", "도", "을", "를", "이", "가", "은", "는", "의", "과", "와", "에", "에서", "으로", "로", "만"
      ]
    },
    "semantic_fingerprint": {
      "enabled": true,
      "require_same_polarity": true,
      "require_same_attribute_when_known": true,
      "minimum_value_overlap_ratio": 1.0
    }
  },

  "clarification": {
    "evaluate_after_reconciliation": true,
    "unknown_operand_requires_clarification": true,
    "consumed_unknown_requires_clarification": false,
    "empty_set_expression_requires_clarification": false,
    "partially_consumed_expression": {
      "rebuild_from_unconsumed_operands": true,
      "requires_clarification_only_for_unresolved_remainder": true
    }
  },

  "conflicts": {
    "same_attribute_opposite_polarity": "clarify",
    "same_attribute_same_value": "deduplicate",
    "same_attribute_different_values": "merge_when_compatible",
    "multiple_authoritative_owners": "highest_priority_or_clarify"
  },

  "observability": {
    "include_raw_text": true,
    "hash_algorithm": "sha1",
    "hash_length": 12,
    "max_trace_entries": 50
  }
}
