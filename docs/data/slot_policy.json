{
  "version": "1.1",
  "description": "슬롯 소유권 정책. owner=지금 이 슬롯 값을 확정하는 경로(rule|llm), risk=틀렸을 때의 피해 등급, backstop=LLM 없이 어떻게 되는가(rule=정규식 백스톱 있음 / fail_close=미해석 표시 / none=조용한 소실, 결함). 승격(rule to llm)은 parser_shadow 누적 관찰이 promotion_gates 문턱을 넘고 위험 판정 0건일 때만 한다.",
  "risk_meaning": {
    "low": "틀려도 후보가 조금 넓어지거나 좁아지는 정도",
    "medium": "대상 집합이 눈에 띄게 달라진다",
    "high": "조용히 0명이 되거나 전혀 다른 모집단이 된다"
  },
  "backstop_meaning": {
    "rule": "정규식/렉시콘 백스톱이 있다 — LLM 이 없어도 좁게나마 값을 만든다",
    "fail_close": "백스톱이 없고, 못 만들면 미해석으로 표시한다",
    "none": "백스톱도 표시도 없다 — 조용한 소실. 결함이며 0 이 되어야 한다"
  },
  "promotion_gates": {
    "low": {
      "min_observations": 20,
      "min_agreement": 0.9
    },
    "medium": {
      "min_observations": 50,
      "min_agreement": 0.97
    },
    "high": {
      "min_observations": 200,
      "min_agreement": 0.995
    }
  },
  "unregistered_default": {
    "owner": "rule",
    "risk": "high",
    "backstop": "rule",
    "note": "정책 미등록 — 기본값(규칙 소유/최고 위험)"
  },
