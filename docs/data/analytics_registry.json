          },
          "memberField": {
            "entity": "campaign_response", "field": "memberNumber", "table": "MCS_CAMP_MBR_RSPN_FT",
            "column": "MBR_NO", "expression": "R.MBR_NO", "outputAlias": "MBR_NO"
          },
          "assumptions": ["캠페인 반응 회원 수는 반응 팩트의 고유 MBR_NO로 계산합니다(회원 상태 정책은 적용되지 않습니다)."]
        }
      ]
    },
    {
      "id": "purchase_count",
