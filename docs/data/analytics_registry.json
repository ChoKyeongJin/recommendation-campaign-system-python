{
  "description": "분석 집계 계약 레지스트리. 지표·차원·필터·모집단 스코프를 논리 선언 1개로 두고, 물리 매핑은 소스의 테이블/조인에서 계산한다(조합 행렬을 손으로 유지하지 않는다).",
  "aggregateFunctions": {
    "SUM": ["합계", "총액", "총합", "전체 금액", "전체 구매 금액", "총 구매금액", "합산", "얼마"],
    "COUNT": ["건수", "개수", "몇 건"],
    "AVG": ["평균"],
    "MAX": ["최대", "최고", "가장 최근", "최근"],
    "MIN": ["최소", "최저", "가장 오래된", "오래된"]
  },
  "unsupportedMetricQualifiers": ["미래 예상", "미래예상", "예측 구매", "예상 구매"],
  "memberScopes": [
    {
      "id": "purchase",
      "domain": "purchase",
      "label": "구매 이력",
      "entity": "order",
      "type": "exists",
      "terms": ["구매한", "구입한", "주문한", "결제한", "구매 고객", "구매고객", "구매 회원", "구매회원", "구매 이력이 있는", "구매경험"],
      "negationTerms": ["구매하지 않은", "구매하지않은", "구매한 적 없는", "구매 이력이 없는", "미구매", "주문하지 않은", "구매 안 한", "구매를 안 한"],
      "table": "CRM_SL_ORDERHEADERMALL",
      "alias": "OH",
      "join": "{alias}.MEMBER_NO = {member}",
      "dateColumn": "ORDER_DATE",
      "hostTables": ["CRM_MB_BASEINFO"]
    },
    {
      "id": "login",
      "domain": "login",
      "label": "로그인 이력",
      "entity": "member",
      "type": "column",
      "terms": ["로그인한", "접속한", "로그인 회원", "로그인회원", "로그인 고객"],
      "negationTerms": ["로그인하지 않은", "접속하지 않은", "로그인한 적 없는", "미접속"],
      "existsPredicate": "{host}.LAST_LOGIN_DATE IS NOT NULL",
      "absencePredicate": "{host}.LAST_LOGIN_DATE IS NULL",
      "dateColumn": "LAST_LOGIN_DATE",
      "hostTables": ["CRM_MB_BASEINFO"]
    },
    {
      "id": "campaign_response",
      "domain": "campaign_response",
      "label": "캠페인 반응",
      "entity": "campaign_response",
      "type": "exists",
      "terms": ["캠페인에 반응", "캠페인반응", "반응한 회원", "반응 회원", "반응회원", "반응한 고객", "반응 고객"],
      "negationTerms": ["반응하지 않은", "반응이 없는", "무반응"],
      "table": "MCS_CAMP_MBR_RSPN_FT",
      "alias": "R",
      "join": "TRY_CAST({alias}.MBR_NO AS BIGINT) = {member}",
      "conditions": ["{alias}.CGRP_TYPE_CD = 'T'", "({alias}.OFFR_RSPN_YN = 'Y' OR {alias}.BUY_RSPN_YN = 'Y')"],
      "hostTables": ["CRM_MB_BASEINFO"],
      "assumption": "캠페인 반응은 대상군(CGRP_TYPE_CD='T') 중 오퍼 반응 또는 구매 반응이 있는 회원으로 계산합니다."
    },
    {
      "id": "cart",
      "domain": "cart",
      "label": "장바구니 보유",
      "entity": "cart",
      "type": "exists",
      "terms": ["장바구니에 담은", "장바구니를 담은", "장바구니에 상품을 담은", "장바구니 보유", "장바구니가 있는"],
      "negationTerms": ["장바구니에 담지 않은", "장바구니가 비어", "장바구니가 없는"],
      "table": "ODS_MALL_OMS_CART",
      "alias": "C",
      "join": "{alias}.CART_ID = {host}.MEMBER_ID",
      "conditions": ["{alias}.KEEP_YN = 'Y'"],
      "hostTables": ["CRM_MB_BASEINFO"],
      "assumption": "장바구니 보유는 유지중(KEEP_YN='Y')인 장바구니 행이 있는 회원으로 계산합니다."
    }
  ],
  "metrics": [
    {
      "id": "coupon_purchase_amount",
      "priority": 300,
      "terms": ["구매금액", "구매 금액", "구매액", "결제금액", "결제 금액"],
      "requiredTerms": [["쿠폰"], ["사용"]],
      "defaultFunction": "SUM",
      "allowedFunctions": ["SUM", "AVG", "MAX", "MIN"],
      "sources": [{
        "id": "campaign_coupon_fact",
        "table": "MCS_CAMP_MBR_RSPN_FT",
        "alias": "R",
        "measure": {"entity": "coupon_response", "field": "offerPurchaseAmount", "table": "MCS_CAMP_MBR_RSPN_FT", "column": "OFFR_BUY_AMT", "expression": "R.OFFR_BUY_AMT", "alias": "TOTAL_PURCHASE_AMOUNT"},
        "memberField": {"entity": "campaign_response", "field": "memberNumber", "table": "MCS_CAMP_MBR_RSPN_FT", "column": "MBR_NO", "expression": "R.MBR_NO", "outputAlias": "MBR_NO"},
        "fixedFilters": [
          {"id": "target_campaign_group", "entity": "campaign_response", "field": "campaignGroupType", "table": "MCS_CAMP_MBR_RSPN_FT", "column": "CGRP_TYPE_CD", "expression": "R.CGRP_TYPE_CD", "operator": "eq", "value": "T"},
          {"id": "coupon_used", "entity": "coupon_response", "field": "usedCouponCount", "table": "MCS_CAMP_MBR_RSPN_FT", "column": "USE_CPN_CNT", "expression": "R.USE_CPN_CNT", "operator": "gt", "value": 0}
        ],
        "assumptions": ["쿠폰 사용으로 발생한 구매금액은 캠페인 반응 팩트의 OFFR_BUY_AMT로 계산합니다."]
      }]
    },
    {
      "id": "campaign_purchase_amount",
      "priority": 200,
      "terms": ["구매금액", "구매 금액", "구매액", "결제금액", "결제 금액"],
      "requiredTerms": [["캠페인"]],
      "defaultFunction": "SUM",
      "allowedFunctions": ["SUM", "AVG", "MAX", "MIN"],
      "sources": [{
        "id": "campaign_purchase_fact",
        "table": "MCS_CAMP_MBR_RSPN_FT",
        "alias": "R",
        "measure": {"entity": "campaign_response", "field": "purchaseAmount", "table": "MCS_CAMP_MBR_RSPN_FT", "column": "BUY_AMT", "expression": "R.BUY_AMT", "alias": "TOTAL_PURCHASE_AMOUNT"},
        "memberField": {"entity": "campaign_response", "field": "memberNumber", "table": "MCS_CAMP_MBR_RSPN_FT", "column": "MBR_NO", "expression": "R.MBR_NO", "outputAlias": "MBR_NO"},
        "fixedFilters": [
          {"id": "target_campaign_group", "entity": "campaign_response", "field": "campaignGroupType", "table": "MCS_CAMP_MBR_RSPN_FT", "column": "CGRP_TYPE_CD", "expression": "R.CGRP_TYPE_CD", "operator": "eq", "value": "T"},
          {"id": "campaign_purchase_response", "entity": "campaign_response", "field": "purchaseResponse", "table": "MCS_CAMP_MBR_RSPN_FT", "column": "BUY_RSPN_YN", "expression": "R.BUY_RSPN_YN", "operator": "eq", "value": "Y"}
        ]
      }]
    },
    {
      "id": "purchase_date",
      "priority": 190,
      "terms": ["구매일", "구매 일자", "구매일자", "주문일", "주문 일자"],
      "defaultFunction": "MAX",
      "allowedFunctions": ["MAX", "MIN"],
      "sources": [{
        "id": "purchase_date_header",
        "table": "CRM_SL_ORDERHEADERMALL",
        "alias": "O",
        "providesScopes": ["purchase"],
        "measure": {"entity": "order", "field": "orderDate", "table": "CRM_SL_ORDERHEADERMALL", "column": "ORDER_DATE", "expression": "O.ORDER_DATE", "alias": "PURCHASE_DATE"},
        "memberField": {"entity": "member", "field": "memberNumber", "table": "CRM_SL_ORDERHEADERMALL", "column": "MEMBER_NO", "expression": "O.MEMBER_NO", "outputAlias": "MEMBER_NO"},
        "dateField": {"entity": "order", "field": "orderDate", "table": "CRM_SL_ORDERHEADERMALL", "column": "ORDER_DATE", "expression": "O.ORDER_DATE"},
        "joins": [{"id": "member", "table": "CRM_MB_BASEINFO", "alias": "B", "on": "B.MEMBER_NO = O.MEMBER_NO"}]
      }]
    },
    {
      "id": "login_count",
      "priority": 180,
      "terms": ["로그인 횟수", "로그인횟수", "로그인 수", "로그인수"],
      "defaultFunction": "MAX",
      "allowedFunctions": ["MAX", "MIN", "AVG", "SUM"],
      "rankingSource": {
        "id": "member_login_count",
        "table": "CRM_MB_BASEINFO",
        "alias": "B",
        "member": {"entity": "member", "field": "memberNumber", "table": "CRM_MB_BASEINFO", "column": "MEMBER_NO", "expression": "B.MEMBER_NO", "outputAlias": "CUST_ID"},
        "measure": {"entity": "member", "field": "totalLoginCount", "table": "CRM_MB_BASEINFO", "column": "TOTAL_LOGIN_CNT", "expression": "B.TOTAL_LOGIN_CNT", "alias": "LOGIN_COUNT"},
        "aggregationFunction": "MAX",
        "fixedFilters": [{"id": "active_member", "entity": "member", "field": "memberStateCode", "table": "CRM_MB_BASEINFO", "column": "MEMBER_STATE_CD", "expression": "B.MEMBER_STATE_CD", "operator": "eq", "value": "MEMBER_STATE_CD.NORMAL"}]
      },
      "sources": [{
        "id": "member_login_count_base",
        "table": "CRM_MB_BASEINFO",
        "alias": "B",
        "measure": {"entity": "member", "field": "totalLoginCount", "table": "CRM_MB_BASEINFO", "column": "TOTAL_LOGIN_CNT", "expression": "B.TOTAL_LOGIN_CNT", "alias": "LOGIN_COUNT"},
        "memberField": {"entity": "member", "field": "memberNumber", "table": "CRM_MB_BASEINFO", "column": "MEMBER_NO", "expression": "B.MEMBER_NO", "outputAlias": "MEMBER_NO"},
        "policyFilters": ["active_member"],
        "assumptions": ["로그인 횟수는 회원 기본정보의 누적 로그인 횟수(TOTAL_LOGIN_CNT)입니다."]
      }]
    },
    {
      "id": "carrot_balance",
      "priority": 180,
      "terms": ["적립금", "적립금 잔액", "당근", "당근 잔액"],
