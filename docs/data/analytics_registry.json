      "allowedFunctions": ["MAX", "MIN", "AVG", "SUM"],
      "rankingSource": {
        "id": "member_carrot_balance",
        "table": "CRM_MB_BASEINFO",
        "alias": "B",
        "member": {"entity": "member", "field": "memberNumber", "table": "CRM_MB_BASEINFO", "column": "MEMBER_NO", "expression": "B.MEMBER_NO", "outputAlias": "CUST_ID"},
        "measure": {"entity": "member", "field": "carrotBalanceAmount", "table": "CRM_MB_BASEINFO", "column": "CARROT_BALANCE_AMT", "expression": "B.CARROT_BALANCE_AMT", "alias": "CARROT_BALANCE_AMOUNT"},
        "aggregationFunction": "MAX",
        "fixedFilters": [{"id": "active_member", "entity": "member", "field": "memberStateCode", "table": "CRM_MB_BASEINFO", "column": "MEMBER_STATE_CD", "expression": "B.MEMBER_STATE_CD", "operator": "eq", "value": "MEMBER_STATE_CD.NORMAL"}]
      },
      "sources": [{
        "id": "member_carrot_balance_base",
        "table": "CRM_MB_BASEINFO",
        "alias": "B",
        "measure": {"entity": "member", "field": "carrotBalanceAmount", "table": "CRM_MB_BASEINFO", "column": "CARROT_BALANCE_AMT", "expression": "B.CARROT_BALANCE_AMT", "alias": "CARROT_BALANCE_AMOUNT"},
        "memberField": {"entity": "member", "field": "memberNumber", "table": "CRM_MB_BASEINFO", "column": "MEMBER_NO", "expression": "B.MEMBER_NO", "outputAlias": "MEMBER_NO"},
        "policyFilters": ["active_member"]
      }]
    },
    {
      "id": "deposit_balance",
      "priority": 180,
      "terms": ["예치금", "예치금 잔액"],
      "defaultFunction": "MAX",
      "allowedFunctions": ["MAX", "MIN", "AVG", "SUM"],
      "rankingSource": {
        "id": "member_deposit_balance",
        "table": "CRM_MB_BASEINFO",
        "alias": "B",
        "member": {"entity": "member", "field": "memberNumber", "table": "CRM_MB_BASEINFO", "column": "MEMBER_NO", "expression": "B.MEMBER_NO", "outputAlias": "CUST_ID"},
        "measure": {"entity": "member", "field": "depositBalanceAmount", "table": "CRM_MB_BASEINFO", "column": "DEPOSIT_BALANCE_AMT", "expression": "B.DEPOSIT_BALANCE_AMT", "alias": "DEPOSIT_BALANCE_AMOUNT"},
        "aggregationFunction": "MAX",
        "fixedFilters": [{"id": "active_member", "entity": "member", "field": "memberStateCode", "table": "CRM_MB_BASEINFO", "column": "MEMBER_STATE_CD", "expression": "B.MEMBER_STATE_CD", "operator": "eq", "value": "MEMBER_STATE_CD.NORMAL"}]
      },
      "sources": [{
        "id": "member_deposit_balance_base",
        "table": "CRM_MB_BASEINFO",
        "alias": "B",
        "measure": {"entity": "member", "field": "depositBalanceAmount", "table": "CRM_MB_BASEINFO", "column": "DEPOSIT_BALANCE_AMT", "expression": "B.DEPOSIT_BALANCE_AMT", "alias": "DEPOSIT_BALANCE_AMOUNT"},
        "memberField": {"entity": "member", "field": "memberNumber", "table": "CRM_MB_BASEINFO", "column": "MEMBER_NO", "expression": "B.MEMBER_NO", "outputAlias": "MEMBER_NO"},
        "policyFilters": ["active_member"]
      }]
    },
    {
      "id": "cart_product_quantity",
      "priority": 180,
      "terms": ["장바구니 상품", "장바구니상품", "장바구니 수량", "카트 상품"],
      "defaultFunction": "SUM",
      "allowedFunctions": ["SUM", "MAX", "MIN", "AVG"],
      "rankingSource": {
        "id": "active_cart_quantity_by_member",
        "table": "ODS_MALL_OMS_CART",
        "alias": "C",
        "member": {"entity": "member", "field": "memberId", "table": "ODS_MALL_OMS_CART", "column": "CART_ID", "expression": "C.CART_ID", "outputAlias": "CUST_ID"},
        "measure": {"entity": "cart", "field": "quantity", "table": "ODS_MALL_OMS_CART", "column": "QTY", "expression": "C.QTY", "alias": "CART_PRODUCT_QUANTITY"},
        "aggregationFunction": "SUM",
        "fixedFilters": [{"id": "active_cart", "entity": "cart", "field": "keepYn", "table": "ODS_MALL_OMS_CART", "column": "KEEP_YN", "expression": "C.KEEP_YN", "operator": "eq", "value": "Y"}],
        "assumptions": ["ODS_MALL_OMS_CART.CART_ID is the member login identifier mapped to CRM_MB_BASEINFO.MEMBER_ID."]
      },
      "sources": [{
        "id": "active_cart_quantity",
        "table": "ODS_MALL_OMS_CART",
        "alias": "C",
        "providesScopes": ["cart"],
        "measure": {"entity": "cart", "field": "quantity", "table": "ODS_MALL_OMS_CART", "column": "QTY", "expression": "C.QTY", "alias": "CART_PRODUCT_QUANTITY"},
        "memberField": {"entity": "member", "field": "memberId", "table": "ODS_MALL_OMS_CART", "column": "CART_ID", "expression": "C.CART_ID", "outputAlias": "CART_ID"},
        "fixedFilters": [{"id": "active_cart", "entity": "cart", "field": "keepYn", "table": "ODS_MALL_OMS_CART", "column": "KEEP_YN", "expression": "C.KEEP_YN", "operator": "eq", "value": "Y"}]
      }]
    },
    {
      "id": "member_count",
      "priority": 250,
      "terms": ["회원 수", "회원수", "고객 수", "고객수", "가입자 수", "가입자수"],
