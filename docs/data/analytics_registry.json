          },
          "memberField": {
            "entity": "member", "field": "memberNumber", "table": "CRM_SL_ORDERDETAILMALL",
            "column": "MEMBER_NO", "expression": "D.MEMBER_NO", "outputAlias": "MEMBER_NO"
          },
          "dateField": {
            "entity": "order_item", "field": "orderDate", "table": "CRM_SL_ORDERDETAILMALL",
            "column": "ORDER_DATE", "expression": "D.ORDER_DATE"
          },
          "joins": [
            {"id": "product", "table": "CRM_CM_PRODUCT", "alias": "P", "on": "P.PRODUCT_ID = D.PRODUCT_ID"},
            {"id": "member", "table": "CRM_MB_BASEINFO", "alias": "B", "on": "B.MEMBER_NO = D.MEMBER_NO"}
