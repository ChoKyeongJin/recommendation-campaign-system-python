          "alias": "B",
          "measure": {
            "entity": "member", "field": "memberNumber", "table": "CRM_MB_BASEINFO",
            "column": "MEMBER_NO", "expression": "B.MEMBER_NO", "alias": "MEMBER_COUNT", "distinct": true
          },
          "memberField": {
            "entity": "member", "field": "memberNumber", "table": "CRM_MB_BASEINFO",
            "column": "MEMBER_NO", "expression": "B.MEMBER_NO", "outputAlias": "MEMBER_NO"
          },
          "policyFilters": ["active_member"],
          "assumptions": ["회원 수는 회원 기본정보의 고유 MEMBER_NO로 계산합니다."]
        },
        {
          "id": "purchasing_member_detail",
          "table": "CRM_SL_ORDERDETAILMALL",
          "alias": "D",
          "whenAnyDimensions": ["brand", "category"],
          "providesScopes": ["purchase"],
          "measure": {
            "entity": "member", "field": "memberNumber", "table": "CRM_SL_ORDERDETAILMALL",
            "column": "MEMBER_NO", "expression": "D.MEMBER_NO", "alias": "MEMBER_COUNT", "distinct": true
          },
          "memberField": {
            "entity": "member", "field": "memberNumber", "table": "CRM_SL_ORDERDETAILMALL",
            "column": "MEMBER_NO", "expression": "D.MEMBER_NO", "outputAlias": "MEMBER_NO"
          },
          "dateField": {"entity": "order_item", "field": "orderDate", "table": "CRM_SL_ORDERDETAILMALL", "column": "ORDER_DATE", "expression": "D.ORDER_DATE"},
          "joins": [
            {"id": "product", "table": "CRM_CM_PRODUCT", "alias": "P", "on": "P.PRODUCT_ID = D.PRODUCT_ID"},
            {"id": "member", "table": "CRM_MB_BASEINFO", "alias": "B", "on": "B.MEMBER_NO = D.MEMBER_NO"}
          ],
          "policyFilters": ["active_member"],
          "assumptions": ["구매 고객 수는 주문 상세의 고유 MEMBER_NO로 계산합니다."]
        },
        {
          "id": "campaign_response_member",
          "table": "MCS_CAMP_MBR_RSPN_FT",
          "alias": "R",
