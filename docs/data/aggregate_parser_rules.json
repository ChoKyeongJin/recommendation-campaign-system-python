{
  "version": 1,
  "span_binding": {
    "max_unit_whitespace": 1,
    "attribute_search_left_tokens": 4,
    "attribute_search_right_tokens": 4,
    "stop_at_conjunction": true,
    "stop_at_clause_boundary": true,
    "conjunction_tokens": ["이고", "이며", "그리고", "이면서", "면서", "동시에", "했고", "았고", "었고", "하고", "이지만", "하지만", "지만", "반면에", "반면"],
    "disjunction_tokens": ["또는", "이거나", "거나", "혹은", "아니면"],
    "boundary_punctuation": [",", ".", "?", "!", ";", ":", "\n"],
    "generic_attribute_particles": ["이", "가"],
    "generic_attribute_min_length": 2
  },
  "number_multipliers": {
    "조": 1000000000000,
    "억": 100000000,
    "천만": 10000000,
    "백만": 1000000,
    "만": 10000,
    "천": 1000
  },
  "prefix_operators": [
    {"surface": "최소", "operator": ">="},
    {"surface": "최대", "operator": "<="}
  ],
  "unit_kinds": ["currency", "quantity", "count", "variety", "person_count", "duration", "area", "age", "ratio"],
