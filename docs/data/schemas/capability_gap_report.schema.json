{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal/schemas/capability_gap_report.schema.json",
  "title": "Offline canonical capability gap report",
  "description": "A deterministic, non-executable report derived from approved registries, implementation evidence, and the P4 coverage inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "snapshot",
    "policy",
    "inventory",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "capability-gap-report/v1"
    },
    "report_id": {
      "$ref": "#/$defs/stableId"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9._-]*:\\S+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_revision",
        "dirty",
        "content_sha256",
        "source_hashes"
      ],
      "properties": {
        "git_revision": {
          "oneOf": [
            {"$ref": "#/$defs/gitRevision"},
            {"type": "null"}
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_hashes": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_availability_policy",
        "discovery_only",
        "executable",
        "mutation_allowed",
        "runtime_failure_codes_reused"
      ],
      "properties": {
        "data_availability_policy": {
          "const": "advise"
        },
        "discovery_only": {
          "const": true
        },
        "executable": {
          "const": false
        },
        "mutation_allowed": {
          "const": false
        },
        "runtime_failure_codes_reused": {
          "const": false
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_columns",
        "legacy_columns",
        "missing_columns",
        "missing_axes",
        "exempt_columns",
        "by_axis",
        "columns"
      ],
      "properties": {
        "canonical_columns": {
          "type": "integer",
          "minimum": 0
        },
        "legacy_columns": {
          "type": "integer",
          "minimum": 0
        },
        "missing_columns": {
          "type": "integer",
          "minimum": 0
        },
        "missing_axes": {
          "type": "integer",
          "minimum": 0
        },
        "exempt_columns": {
          "type": "integer",
          "minimum": 0
        },
        "by_axis": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "columns": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_path",
        "source_pointer",
        "extraction_method",
        "confidence",
        "content_hash",
        "revision",
        "trust_state"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_pointer": {
          "type": "string",
          "minLength": 1,
          "description": "A JSON Pointer or a stable code symbol locator."
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "revision": {
          "oneOf": [
            {"$ref": "#/$defs/gitRevision"},
            {"type": "null"}
          ]
        },
        "trust_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "extraction_method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "affectedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "field_path",
        "role",
        "observed",
        "expected",
        "evidence"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/$defs/stableId"
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "declaration",
            "alias",
            "operator",
            "physical_binding",
            "expressibility",
            "test_coverage",
            "routing",
            "policy",
            "other"
          ]
        },
        "observed": {
          "$ref": "#/$defs/jsonValue"
        },
        "expected": {
          "$ref": "#/$defs/jsonValue"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "blockingQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question",
        "status",
        "blocks_candidate",
        "evidence"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/stableId"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["open", "answered"]
        },
        "blocks_candidate": {
          "type": "boolean"
        },
        "answer": {
          "type": ["string", "null"]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "conflictValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence"],
      "properties": {
        "value": {
          "$ref": "#/$defs/jsonValue"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "field_path",
        "values",
        "status"
      ],
      "properties": {
        "conflict_id": {
          "$ref": "#/$defs/stableId"
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/conflictValue"
          }
        },
        "status": {
          "enum": ["open", "resolved", "accepted_divergence"]
        },
        "resolution": {
          "type": ["string", "null"]
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "classification",
        "concept_id",
        "summary",
        "legacy_assets",
        "approved_assets",
        "evidence",
        "details",
        "blocking_questions",
        "conflicts"
      ],
      "properties": {
        "gap_id": {
          "$ref": "#/$defs/stableId"
        },
        "classification": {
          "enum": [
            "LEGACY_ONLY",
            "CANONICAL_ONLY",
            "ALIAS_MISSING",
            "OPERATOR_MISMATCH",
            "VALUE_MAPPING_MISSING",
            "LOWERING_MISSING",
            "COMPILER_MISSING",
            "PHYSICAL_BINDING_MISSING",
            "TEST_COVERAGE_MISSING",
            "STALE_APPROVED_ASSET",
            "EXPRESSIBILITY_UNDECLARED",
            "CONFLICTING_DEFINITION"
          ]
        },
        "concept_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "legacy_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "approved_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["axis", "missing_columns"],
          "properties": {
            "axis": {"type": "string", "minLength": 1},
            "column": {"type": "string", "minLength": 1},
            "missing_columns": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "expected": {"$ref": "#/$defs/jsonValue"},
            "observed": {"$ref": "#/$defs/jsonValue"},
            "note": {"type": "string"}
          }
        },
        "disposition": {
          "enum": ["advisory", "needs_review", "blocked_by_question", "conflict"]
        },
        "affected_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/affectedField"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "blocking_questions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
