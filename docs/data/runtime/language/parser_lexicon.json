  "patterns": {
    "member_noun_core": {
      "include": [
        "member_noun"
      ]
    },
    "purchase_rank_target": {
      "include": [
        "member_noun",
        "member_noun_informal",
        "member_noun_honorific",
        "member_noun_role"
      ],
      "exclude": [
        "사용자"
      ],
      "note": "구매 랭킹 대상 명사. '사용자'만 빠져 있다 — 누락 의심(다른 회원 명사 패턴에는 모두 있다)."
    },
    "exact_equals_marker": {
      "include": [
        "exact_marker"
      ]
    },
    "dimension_rank_high": {
      "include": [
        "direction_high",
        "sort_directive_high",
        "superlative_most"
      ],
      "exclude": [
        "큰"
      ],
      "note": "축 행 랭킹의 '많은 쪽' 순위 표지. 공백을 지운 compact 문자열에 매칭하므로 낱말에 공백이 없다. 크기 형용사 '큰'은 '큰 시군구'(면적)로 읽혀 축 개수 표현이 아니라 제외한다."
    },
    "dimension_rank_low": {
      "include": [
        "direction_low",
        "sort_directive_low",
        "superlative_least"
      ],
      "exclude": [
        "작은"
      ],
      "note": "축 행 랭킹의 '적은 쪽' 순위 표지. dimension_rank_high 와 대칭으로 크기 형용사 '작은'을 제외한다."
    },
    "purchase_scope_nonspecific_determiner": {
      "include": [
        "indefinite_determiner",
        "deictic_determiner",
        "partitive_determiner",
        "variety_determiner",
        "universal_determiner"
      ],
      "exclude": [
        "해당",
        "가지각색"
      ],
      "note": "구매 스코프 값이 될 수 없는 비특정 한정사(graph_rag._PURCHASE_SCOPE_NON_ENTITY_TERMS 이관). '해당'·'가지각색'은 이관 전 이 목록에 없었다 — 같은 뜻의 purchase_object_nonspecific_determiner 에는 '해당'이 있으므로 누락 의심이다."
    },
    "purchase_object_nonspecific_determiner": {
      "include": [
        "indefinite_determiner",
        "deictic_determiner",
        "partitive_determiner",
        "variety_determiner",
        "universal_determiner"
      ],
      "exclude": [
        "가지각색"
      ],
      "note": "상품명 후보 sanitize 가 버리는 비특정 한정사(graph_rag._sanitize_purchase_object 이관). '가지각색'만 이관 전에 없었다."
    },
    "scope_placeholder_value": {
      "include": [
        "indefinite_determiner",
        "deictic_determiner",
        "partitive_determiner",
        "universal_determiner"
      ],
      "exclude": [
        "전체",
        "전부",
        "모두"
      ],
      "note": "값이 지정되지 않은 스코프 자리표시자('특정 브랜드'). 이관 전에는 전칭 한정사 중 '모든'만 있었다 — '전체/전부/모두'는 그때 없었으므로 동작 보존을 위해 제외한다(누락 의심)."
    },
    "scope_distinct_modifier": {
      "include": [
        "variety_determiner",
        "otherness_reference"
      ],
      "exclude": [
        "외",
        "외의"
      ],
      "note": "'서로 다른 브랜드'의 수식어 — 값이 아니라 '가짓수를 센다'는 표지다. 배제 표현('외/외의')은 가짓수 표지가 아니라 이관 전에도 없었다."
    },
    "distinct_count_marker": {
      "include": [
        "variety_determiner",
        "otherness_reference",
        "distinct_count_noun"
      ],
      "exclude": [
        "외",
        "외의"
      ],
      "note": "'가짓수를 센다'는 표지 전체. scope_distinct_modifier(수식어 자리)보다 넓다 — 수식어 없이 명사만으로 같은 뜻이 되는 '상품 종류가 2개 이상'을 함께 잡아야 하기 때문이다. 배제 사유는 scope_distinct_modifier 와 같다."
    },
    "generic_scope_reference": {
      "include": [
        "otherness_reference",
        "deictic_determiner",
        "indefinite_determiner"
      ],
      "exclude": [
        "그",
        "이",
        "저",
        "어떤",
        "무슨",
        "어느",
        "임의"
      ],
      "note": "자유텍스트 스코프에서 구체 값이 아니라 참조·미지정을 뜻하는 말(open_text_scope_claims 이관). 이관 전에는 event_scope_value_stopword 위에 '다른/해당/특정/외/외의' 다섯만 덧붙어 있었다 — 나머지 지시·비특정 한정사는 그때 없었으므로 제외한다(누락 의심)."
    }
  }
}
