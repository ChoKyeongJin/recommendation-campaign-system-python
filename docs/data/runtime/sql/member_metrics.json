    {
      "metric_id": "buy_cycle",
      "agg": "AVG",
      "column": "BUY_CYCLE",
      "ko_label": "구매주기",
      "threshold_unit": "day",
      "synonyms": [
        "구매주기",
        "구매 주기",
        "평균 구매주기",
        "평균 구매 주기",
        "구매 간격"
      ]
    },
    {
      "metric_id": "activity_month_cnt",
      "agg": "SUM",
      "column": "ACTIVITY_MONTH_CNT",
      "ko_label": "활동 개월 수",
      "threshold_unit": "month",
      "synonyms": [
        "활동 개월 수",
        "활동개월수",
        "활동 월수",
        "구매 활동 개월 수"
      ]
    },
    {
      "metric_id": "buy_product_cnt",
      "agg": "SUM",
      "column": "BUY_PRODUCT_CNT",
      "ko_label": "구매 상품 수",
      "threshold_unit": "count",
      "synonyms": [
        "구매 상품 수",
        "구매상품수",
        "구매 제품 수",
        "구매한 상품 수",
        "상품 구매 수"
      ]
    },
    {
      "metric_id": "min_buy_amt",
      "agg": "MIN",
      "column": "MIN_BUY_AMT",
      "ko_label": "최소 구매금액",
      "threshold_unit": "KRW",
      "synonyms": [
        "최소 구매금액",
        "최소 구매 금액",
        "최저 구매금액",
        "최저 결제금액"
      ]
    }
  ]
}
