{
  "version": "1.1",
  "description": "회원 단위 수치 지표 레지스트리(실DB CRM_MB_MONTHCRMINFO 기준). '<지표>가 높은 지역' 같은 그룹 랭킹 타겟팅에서 랭킹 기준으로 쓴다. 새 지표는 여기 한 항목 추가로 끝난다 — 템플릿 코드 추가 없음. grain_filter 는 월 스냅샷 테이블의 중복 집계를 막는 필수 절(최신 월만 사용).",
  "value_table": "CRM_MB_MONTHCRMINFO",
  "join_column": "MEMBER_NO",
  "grain_filter": "C.YYYYMM = (SELECT MAX(YYYYMM) FROM CRM_MB_MONTHCRMINFO)",
  "canonical_event_ir": {
    "label": "회원 지표 전역 순위",
    "source_prefix": "member_metric_",
    "source_alias": "C",
    "time_column": "YYYYMM",
    "time_format": "char6",
    "relation_recipe": "member_metric_ranking",
    "limit_units": ["count", "percent"],
    "directions": {
      "top": ["상위", "높은", "많은", "최고"],
      "bottom": ["하위", "낮은", "적은", "최저"]
    },
    "entities": {
      "member": {
        "terms": ["회원", "고객"]
      }
    },
    "policy": {
      "population": "active_members",
      "tie_policy": "exact_count",
      "null_policy": "exclude",
      "missing_policy": "exclude",
      "small_population_policy": "ceil"
    }
  },
  "metrics": [
    {
      "metric_id": "total_buy_amt",
      "agg": "SUM",
      "column": "TOTAL_BUY_AMT",
      "ko_label": "누적 구매금액",
      "synonyms": [
        "누적 구매금액",
        "누적 구매 금액",
        "총 구매금액",
        "총구매금액",
        "누적구매금액",
        "구매금액"
      ]
    },
    {
      "metric_id": "total_buy_cnt",
      "agg": "SUM",
      "column": "TOTAL_BUY_CNT",
      "ko_label": "누적 구매건수",
      "synonyms": [
        "누적 구매건수",
        "총 구매건수",
        "누적 구매 건수",
        "구매건수"
      ]
    },
    {
      "metric_id": "mean_buy_amt",
      "agg": "AVG",
      "column": "MEAN_BUY_AMT",
      "ko_label": "평균 구매금액",
      "synonyms": [
        "평균 구매금액",
        "평균 구매 금액",
        "평균구매금액"
      ]
    },
    {
      "metric_id": "max_buy_amt",
      "agg": "MAX",
      "column": "MAX_BUY_AMT",
      "ko_label": "최대 구매금액",
      "synonyms": [
        "최대 구매금액",
        "최대 구매 금액",
        "최고 구매금액"
      ]
    },
    {
      "metric_id": "total_buy_qty",
      "agg": "SUM",
      "column": "TOTAL_BUY_QTY",
      "ko_label": "누적 구매수량",
      "synonyms": [
        "누적 구매수량",
        "총 구매수량",
        "누적 구매 수량"
      ]
    },
    {
      "metric_id": "buy_cycle",
      "agg": "AVG",
      "column": "BUY_CYCLE",
      "ko_label": "구매주기",
      "synonyms": [
        "구매주기",
        "구매 주기",
        "평균 구매주기",
        "평균 구매 주기",
        "구매 간격"
      ]
    },
    {
      "metric_id": "activity_month_cnt",
      "agg": "SUM",
      "column": "ACTIVITY_MONTH_CNT",
      "ko_label": "활동 개월 수",
      "synonyms": [
        "활동 개월 수",
        "활동개월수",
        "활동 월수",
        "구매 활동 개월 수"
      ]
    },
    {
      "metric_id": "buy_product_cnt",
      "agg": "SUM",
      "column": "BUY_PRODUCT_CNT",
      "ko_label": "구매 상품 수",
      "synonyms": [
        "구매 상품 수",
        "구매상품수",
        "구매 제품 수",
        "구매한 상품 수",
        "상품 구매 수"
      ]
    },
    {
      "metric_id": "min_buy_amt",
      "agg": "MIN",
      "column": "MIN_BUY_AMT",
      "ko_label": "최소 구매금액",
      "synonyms": [
        "최소 구매금액",
        "최소 구매 금액",
        "최저 구매금액",
        "최저 결제금액"
      ]
    }
  ]
}
