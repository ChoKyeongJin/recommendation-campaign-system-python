{
  "version": 1,

  "_comment": [
    "시간 의미 카탈로그. metric 은 '무엇을'이고 binding 은 '어떻게 관측하는가'다.",
    "새 시간 속성은 여기 항목 하나로 늘어난다 — temporal_ir 의 Python 코드는 바뀌지 않는다.",
    "물리 바인딩(테이블·컬럼·값 코드)의 권위는 audience_catalog.json 에 있고, 여기서 다시 적는",
    "storage_codec·correlation_keys·row_identity 는 사본이 아니라 교차검증 선언이다. 두 선언이",
    "어긋나면 load_temporal_catalog 가 이름을 대며 실패한다.",
    "observation_capabilities 는 여덟 항목 전부를 요구한다. representation 이름에서 추론하지",
    "않는 이유는 §8 이다 — 같은 이름의 표현이라도 적재 방식에 따라 답할 수 있는 것이 다르다."
  ],

  "metrics": {
    "member.grade": {
      "label": "회원 등급",
      "value_type": "string",
      "value_domain": "grade",
      "supported_comparisons": ["=", "!=", ">", ">=", "<", "<="],
      "temporal_bindings": ["member.grade.current", "member.grade.monthly_snapshot"],
      "_comment": "우선순위는 '둘 다 답할 수 있을 때'에만 쓰인다. lowering 이 먼저 계약 검증으로 후보를 거르므로, 과거 시점을 물으면 현재값 관측은 후보에서 탈락하고 스냅샷이 남는다. 반대로 현재 시점은 둘 다 답할 수 있고 그때는 현재값 컬럼이 정확하다(스냅샷은 이번 달 적재를 기다려야 한다).",
      "binding_priority": ["member.grade.current", "member.grade.monthly_snapshot"]
    },
    "member.worth_grade": {
      "label": "가치등급",
      "value_type": "string",
      "value_domain": "worth_grade",
      "supported_comparisons": ["=", "!=", ">", ">=", "<", "<="],
      "temporal_bindings": ["member.worth_grade.monthly_snapshot"]
    },
    "member.newproduct_favor": {
      "label": "신제품 선호 여부",
      "value_type": "string",
      "value_domain": "newproduct_favor_flag",
      "_comment": "Y/N 한 글자에는 부등호를 허용하지 않는다(사전식 순서로 조용히 틀린다).",
      "supported_comparisons": ["=", "!="],
      "temporal_bindings": ["member.newproduct_favor.monthly_snapshot"]
    },
    "member.purchase": {
      "label": "구매",
      "value_type": "event",
      "supported_comparisons": ["=", "!="],
      "temporal_bindings": ["member.purchase.events"]
    },
    "member.login": {
      "label": "로그인",
      "value_type": "event",
      "supported_comparisons": ["=", "!="],
      "temporal_bindings": ["member.login.latest"]
    },
    "member.signup": {
      "label": "가입",
      "value_type": "event",
      "supported_comparisons": ["=", "!="],
      "temporal_bindings": ["member.signup.event"]
    },
    "member.cart_add": {
      "label": "장바구니 담기",
      "value_type": "event",
      "supported_comparisons": ["=", "!="],
      "temporal_bindings": ["member.cart_add.events"]
    },
    "member.campaign_contact": {
      "label": "캠페인 접촉 성공",
      "value_type": "event",
      "supported_comparisons": ["=", "!="],
      "temporal_bindings": ["member.campaign_contact.events"]
    }
  },

  "bindings": {
    "member.grade.current": {
      "label": "현재 회원 등급",
      "metric_id": "member.grade",
      "source": "subject",
      "subject_entity": "member",
      "representation": "current_only",
      "role": "snapshot_time",
      "value_field": "subject.grade",
      "semantic_grain": "day",
      "timezone": "Asia/Seoul",
      "bucket_semantics": "point_in_time",
      "selection_strategies": ["exact_bucket"],
      "supported_operators": ["temporal.as_of"],
      "unique_per_time_point": true,
      "observation_capabilities": {
        "supports_point_state": true,
        "supports_ordered_observations": false,
        "supports_exact_transition_time": false,
        "supports_intra_bucket_changes": false,
        "supports_continuous_validity": false,
        "supports_complete_bucket_enumeration": false,
        "supports_event_count": false,
        "supports_all_occurrences": false
      }
    },

    "member.grade.monthly_snapshot": {
      "label": "월별 스냅샷의 회원 등급",
      "metric_id": "member.grade",
      "source": "member_month_snapshot",
      "subject_entity": "member",
      "representation": "periodic_snapshot",
      "role": "snapshot_time",
      "value_field": "member_month_snapshot.grade",
      "prev_value_field": "member_month_snapshot.prev_grade",
      "time_field": "member_month_snapshot.occurred_at",
      "entity_key_field": "member_month_snapshot.member_no",
      "semantic_grain": "month",
      "storage_codec": "char6",
      "timezone": "Asia/Seoul",
      "calendar": "gregorian",
      "_bucket_semantics_comment": "한 행이 그 달의 월말 상태를 대표한다는 데이터 계약. 이 선언이 없으면 '지난달 말 기준' 요청은 답할 수 없다(그 달 아무 시점의 상태는 다른 집합이다).",
      "bucket_semantics": "period_end_state",
      "correlation_keys": {"subject": "MEMBER_NO", "source": "MEMBER_NO"},
      "row_identity": ["MEMBER_NO", "YYYYMM"],
      "ordering": ["YYYYMM"],
      "unique_per_time_point": true,
      "selection_strategies": ["exact_bucket"],
      "supported_operators": [
        "temporal.as_of",
        "temporal.previous_bucket",
        "temporal.previous_observation",
        "temporal.previous_distinct_value",
        "temporal.in_window",
        "temporal.before",
        "temporal.after",
        "temporal.none",
        "temporal.all",
        "temporal.every_bucket",
        "temporal.unchanged_observations",
        "temporal.direct_transition",
        "temporal.changed_between_endpoints",
        "temporal.changed_within_window",
        "temporal.change_count"
      ],
      "_change_count_comment": "temporal.change_count 를 선언하는 근거는 **스키마 모양**이다: 값 필드와 직전 값 필드가 한 행에 함께 있으므로 '값이 달라진 관측 행 수'를 SQL 로 셀 수 있다. 지금 적재가 한 달뿐이라 그 수가 최대 1이 되는 것은 질의의 답이지 질의를 만들 수 없다는 뜻이 아니므로 여기 선언에서 빼지 않는다. 세는 대상이 '관측된 값 변화'라는 사실은 영수증의 measurement 가 말한다.",
      "_capabilities_comment": "월 스냅샷은 관측된 달의 상태와 관측 사이의 값 변화는 알지만, 월중 실제 변경 시각은 모른다(supports_exact_transition_time/supports_intra_bucket_changes=false). supports_event_count=false 인 이유도 같다 — 스냅샷 행 수는 업무 사건 수가 아니다.",
      "observation_capabilities": {
        "supports_point_state": true,
        "supports_ordered_observations": true,
        "supports_exact_transition_time": false,
        "supports_intra_bucket_changes": false,
        "supports_continuous_validity": false,
        "supports_complete_bucket_enumeration": true,
        "supports_event_count": false,
        "supports_all_occurrences": true
      },
      "coverage": {
        "label": "회원 월별 스냅샷 적재 구간",
        "available_from": "20170101",
        "available_through": "20170131",
        "expected_cadence": "month",
        "completeness": "complete",
        "freshness_through": "20170131",
        "backfill_status": "unknown"
      }
    },

