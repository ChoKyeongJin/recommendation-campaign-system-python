      "label": "캠페인 발송 성공",
      "aliases": ["캠페인 발송 성공", "전송 성공", "접촉 성공", "도달 성공"]
    },
    "campaign_response": {
      "table": "MCS_CAMP_MBR_RSPN_FT",
      "alias": "R",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MBR_NO",
      "time_column": "CAMP_SDATE",
      "time_format": "char8",
      "binding": "fact_table",
      "grain": "event",
      "from_sql": "MCS_CAMP_MBR_RSPN_FT {alias} INNER JOIN Z_CAMPAIGN ZC ON ZC.CAMP_ID = {alias}.CAMP_ID AND ZC.CAMP_EXEC_NO = {alias}.CAMP_EXEC_NO",
      "correlation_sql": "TRY_CAST({alias}.MBR_NO AS BIGINT) = {subject_alias}.{subject_key}",
