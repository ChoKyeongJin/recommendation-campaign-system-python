      "label": "캠페인 반응",
      "aliases": ["캠페인 반응", "오퍼 또는 구매 반응"]
    },
    "campaign_offer_response": {
      "table": "MCS_CAMP_MBR_RSPN_FT",
      "alias": "R",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MBR_NO",
      "time_column": "CAMP_SDATE",
      "time_format": "char8",
