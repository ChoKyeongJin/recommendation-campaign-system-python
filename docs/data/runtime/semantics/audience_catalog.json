{
  "version": "1.0",
  "imports": {
    "member_metric_rankings": {
      "path": "docs/data/runtime/sql/member_metrics.json",
      "relative_to": "repository"
    }
  },
  "subject": {
    "name": "subject",
    "table": "CRM_MB_BASEINFO",
    "alias": "B",
    "key": "MEMBER_NO",
    "label": "회원"
  },
  "value_domains": {
    "_comment": [
      "값 사전(canonical·물리코드·서열·동의어)의 단일 소유자는 member_target_filters.json 의 eq_filters 다.",
      "여기서는 source_category 로 참조만 하고 audience_runtime.materialize_value_domains 가 런타임 조인한다",
      "(attribute_catalog.json 과 같은 이중 소유 금지 계약). 값을 여기 다시 적으면 두 파일이 곧 어긋난다.",
      "ordered:true 는 '이 도메인에는 서열이 있다'는 선언이며, 서열 자체(rank)는 eq_filters 가 소유한다.",
      "서열이 없는 도메인에 '이상/이하'가 오면 컴파일러가 fail-close 한다 — 저장 코드값을 부등호로",
      "비교하면 사전식 순서로 조용히 틀린 집합이 나온다(EMART_GRADE_CD 실측: '골드 이상'에 SILVER·WELCOME 혼입)."
    ],
    "gender": {"label": "성별", "source_category": "gender"},
    "grade": {"label": "회원 등급", "source_category": "grade", "ordered": true},
    "member_state": {"label": "현재 회원 상태", "source_category": "state"},
    "residence_sido": {
      "label": "거주 시도",
      "source_external_region_mapping": "sido",
      "_comment": "공식 시도명→CRM 저장값의 단일 소유자인 external_region_mapping.json을 런타임 조인한다."
    },
    "blacklist_flag": {
      "label": "블랙리스트 여부",
      "values": {
        "blacklisted": {"physical": "Y", "aliases": ["블랙리스트", "발송 제외 고객", "차단 회원"]}
      }
    },
    "site_only_flag": {
      "label": "사이트 전용회원 여부",
      "values": {
        "site_only": {"physical": "Y", "aliases": ["사이트 전용회원", "사이트 전용 회원", "쇼핑몰 전용회원", "쇼핑몰 회원"]},
        "not_site_only": {"physical": "N", "aliases": ["사이트 전용 아님"]}
      }
    },
    "employee_flag": {
      "label": "임직원 여부",
      "values": {
        "employee": {"physical": "Y", "aliases": ["임직원", "직원 회원"]}
      }
    },
    "marriage_flag": {
      "_comment": "순수 Y/N 플래그라 consent_flag 와 같은 근거로 여기서 인라인 선언한다(이중 소유 아님). 별칭에 맨 '결혼'을 넣지 않는다 — WEDDING_DAY(결혼기념일) 를 묻는 문장이 결혼 상태 조건으로 오발화한다.",
      "label": "결혼 여부",
      "values": {
        "married": {"physical": "Y", "aliases": ["기혼", "기혼 회원", "결혼한", "결혼한 회원"]},
        "unmarried": {"physical": "N", "aliases": ["미혼", "미혼 회원", "결혼 안 한"]}
      }
    },
    "newproduct_favor_flag": {
      "_comment": "ordered 를 켜지 않는다 — Y/N 한 글자에 부등호를 허용하면 사전식 순서로 조용히 틀린 SQL 이 된다.",
      "label": "신제품 선호 여부",
      "values": {
        "favors_new_product": {"physical": "Y", "aliases": ["신제품 선호", "신상품 선호", "신제품 선호함"]},
        "not_favors_new_product": {"physical": "N", "aliases": ["신제품 비선호", "신제품 선호하지 않음"]}
      }
    },
    "login_channel": {"label": "마지막 로그인 채널", "source_category": "login_channel"},
    "consent_flag": {
      "label": "수신 동의 여부",
      "_comment": "순수 Y/N 플래그다. eq_filters 는 이 컬럼들을 '동의한 회원'이라는 **필터 정체성**으로 소유하지 그 자체가 값 사전은 아니므로, 여기서 인라인 값 도메인을 선언해도 이중 소유가 아니다.",
      "values": {
        "agreed": {"physical": "Y", "aliases": ["동의", "수신 동의", "동의함", "예"]},
        "declined": {"physical": "N", "aliases": ["거부", "미동의", "동의하지 않음", "아니오"]}
      }
    },
    "worth_grade": {"label": "가치등급", "source_category": "worth_grade", "ordered": true}
  },
  "signal_coverage": {
    "_comment": [
      "원문 신호 family → 이 신호를 Event IR 이 소유한다고 볼 카탈로그 심볼.",
      "결정론 드롭 감지기(graph_rag._deterministic_dropped_conditions)가 슬롯만 보고 오탐을 내지 않도록,",
      "IR 이 실제로 담은 소스/필드를 커버 근거로 쓴다. canonical 이라는 이유로 감지기를 통째로 면제하면",
      "IR 이 표현하지 못하는 축(수신동의·등급/상태 이력)의 조건이 경고 없이 사라진다(2026-08-02 실측).",
      "expressible:false 는 '아직 선언 안 함'이 아니라 '이 대수로 표현할 수 없음'의 명시 선언이다 —",
      "둘을 구분해야 드리프트 가드가 누락을 잡는다. family id 는 graph_rag 의 신호 서명 키를 그대로 쓴다."
    ],
    "gender": {"fields": ["subject.gender"]},
    "member_state": {"fields": ["subject.member_state"]},
    "residence": {"fields": ["subject.residence_sido"]},
    "member_exclusion": {"fields": ["subject.blacklisted", "subject.site_only", "subject.employee"]},
    "cart": {"sources": ["cart", "active_cart"]},
    "login": {"sources": ["login"], "fields": ["subject.last_login_channel"]},
    "purchase_absence": {
      "negated_sources": ["purchase"],
      "note": "회원 전체 구매 부재는 purchase의 부정 Exists로만 전역 커버한다. active_cart의 KEEP_YN='Y'는 해당 카트 라인의 미결제 상태일 뿐이다. 그 상태어가 원문의 구매 부정 표면을 소유하는 범위는 family가 아니라 근거 스팬 단위이며, 소스 선언 selected_by가 그 규칙을 갖는다(같은 절일 때만 소유)."
    },
    "campaign_contact": {"sources": ["campaign_contact_success", "campaign_target"]},
    "offer_response": {"sources": ["campaign_offer_response", "campaign_response"]},
    "buy_response": {"sources": ["campaign_purchase_response", "campaign_response"]},
    "coupon_used": {"expressible": false, "note": "쿠폰 사용 사건 소스가 카탈로그에 없다. 슬롯 경로가 소유한다."},
    "consent": {"fields": ["subject.app_push_consent", "subject.sms_consent", "subject.email_consent", "subject.marketing_consent"], "note": "2026-08-03 P4: 수신동의 4축을 fields 선언 4줄로 열었다(코드 변경 0). 이전에는 expressible:false 였고, 그 상태가 R1 이 지목한 최대 군집(#47·#50·#56)의 미지원 사유였다."},
    "member_grade_history": {"expressible": false, "note": "등급·상태의 시점/이력 축. 2026-08-05 실측 둘을 함께 적는다. (1) 이 family id 를 내는 감지기가 저장소에 없다 — 신호를 만들던 이력 슬롯 경로가 축1 폐기와 함께 삭제됐으므로 이 선언은 현재 아무 판정도 만들지 않는다(선언만 남은 상태). (2) 그럼에도 expressible:false 를 유지하는 이유는 fail-close 방향이기 때문이다(과잉 커버는 조용한 오답, 과소 커버는 시끄러운 오탐). 등급 스냅샷 자체는 sources.member_month_snapshot + fields.member_month_snapshot.* 로 이제 표현되므로, 이 family 를 다시 감지기에 붙이는 날에만 sources 선언으로 바꾼다 — 붙이기 전에 바꾸면 그 순간 과잉 커버가 된다."}
  },
  "sources": {
    "purchase": {
      "table": "CRM_SL_ORDERHEADERMALL",
      "alias": "EO",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MEMBER_NO",
      "time_column": "ORDER_DATE",
      "time_format": "char8",
      "binding": "fact_table",
      "grain": "event",
      "label": "구매",
      "aliases": ["구매", "주문", "결제"]
    },
    "purchase_line": {
      "table": "CRM_SL_ORDERDETAILMALL",
      "alias": "OD",
      "_comment": "상품 자유텍스트는 PRODUCT_ID와 직접 비교하지 않는다. 구매상세 행을 보존하는 LEFT JOIN으로 상품마스터를 한 번 붙이고, 아래 purchase_line.product_* 필드가 이 검증된 별칭만 사용한다.",
      "from_sql": "CRM_SL_ORDERDETAILMALL {alias} LEFT JOIN CRM_CM_PRODUCT {alias}_PRODUCT ON {alias}.PRODUCT_ID = {alias}_PRODUCT.PRODUCT_ID",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MEMBER_NO",
      "time_column": "ORDER_DATE",
      "time_format": "char8",
      "binding": "fact_table",
      "grain": "line",
      "label": "구매 상세",
      "aliases": ["구매 상품", "주문 상품", "판매 상품"]
    },
    "login": {
      "table": "CRM_MB_BASEINFO",
      "alias": "B",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MEMBER_NO",
      "time_column": "LAST_LOGIN_DATE",
      "time_format": "char8",
      "binding": "subject_column",
      "grain": "member",
      "label": "로그인",
      "aliases": ["로그인", "접속"],
      "absence_restatement_terms": ["휴면"],
      "_absence_restatement_comment": "이 사건의 부재를 다시 말하는 상태어. '6개월 이상 접속하지 않은 휴면 고객'의 '휴면'은 새 조건이 아니라 앞 절의 동어반복이므로 잔여물 검사에서 프레임으로 허용한다. 예전에는 문형 정규식이 이 낱말을 조용히 삼켰다 — 선언으로 드러내야 드리프트 가드가 볼 수 있다."
    },
    "signup": {
      "table": "CRM_MB_BASEINFO",
      "alias": "B",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MEMBER_NO",
      "time_column": "REG_DT",
      "time_format": "char8",
      "binding": "subject_column",
      "grain": "member",
      "label": "가입",
      "aliases": ["가입", "등록"]
    },
    "cart": {
      "_comment": "장바구니의 회원키는 CART_ID(로그인ID 문자열)이고 짝은 회원 테이블의 MEMBER_ID 다 — MEMBER_NO(bigint)가 아니다. schema_catalog 주석 'CART_ID = 회원의 MEMBER_ID'를 '이 테이블에 MEMBER_ID 가 있다'로 읽어 event_subject_key 를 MEMBER_ID 로 적었고, 그 컬럼은 존재하지 않아 장바구니 프롬프트 전체가 런타임 sql_guard(column_not_allowed)에서 죽었다(2026-08-03 실측). 실DB 대조: 장바구니 회원 14,797명 중 14,770명이 CART_ID↔MEMBER_ID 로 매칭된다. UPD_DT 는 datetime2 라 저장 포맷도 char8 이 아니라 date 다.",
      "table": "ODS_MALL_OMS_CART",
      "alias": "EC",
      "from_sql": "ODS_MALL_OMS_CART {alias} LEFT JOIN CRM_CM_PRODUCT {alias}_PRODUCT ON {alias}.PRODUCT_ID = {alias}_PRODUCT.PRODUCT_ID",
      "subject_key": "MEMBER_ID",
      "event_subject_key": "CART_ID",
      "time_column": "UPD_DT",
      "time_format": "date",
      "binding": "fact_table",
      "grain": "event",
      "label": "장바구니 담기",
      "aliases": ["장바구니", "카트", "담기"]
    },
    "active_cart": {
      "_comment": "미결제 장바구니 전용 사건. KEEP_YN='Y' 자체가 아직 결제되지 않고 보관 중인 동일 카트 라인을 뜻하며, 발생 시각은 담은 시점 INS_DT다. 별도 회원 전체 주문 NOT EXISTS를 붙이면 다른 상품 구매자까지 제외하므로 금지한다.",
      "table": "ODS_MALL_OMS_CART",
      "alias": "EAC",
      "subject_key": "MEMBER_ID",
      "event_subject_key": "CART_ID",
      "time_column": "INS_DT",
      "time_format": "date",
      "binding": "fact_table",
      "extra_predicates": ["{alias}.KEEP_YN = 'Y'"],
      "grain": "event",
      "label": "미결제 장바구니",
      "aliases": ["보관 중 장바구니", "미결제 장바구니", "장바구니 이탈"],
      "selected_by": {
        "source": "cart",
        "negated_event": "purchase",
        "window": "rolling_duration",
        "note": "'장바구니 표면 + 구매 부정이 같은 절'이면 그 요청이 고르는 소스는 cart + 회원 전체 구매 NOT EXISTS가 아니라 이 KEEP_YN='Y' 상태 소스다. 이것은 파서 사정이 아니라 도메인 사실이라 카탈로그가 갖는다 — 유사 축(미사용 쿠폰 등)은 이 선언 한 항목으로 는다. 창 종류를 rolling_duration으로 못 박는 이유는 '30일 전'(past_point)이 롤링 창이 아니기 때문이다."
      }
    },
    "member_month_snapshot": {
      "table": "CRM_MB_MONTHCRMINFO",
      "alias": "MS",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MEMBER_NO",
      "time_column": "YYYYMM",
      "time_format": "char6",
      "binding": "fact_table",
      "grain": "event",
      "label": "회원 월별 스냅샷",
      "aliases": ["월별 스냅샷", "기준월 스냅샷"]
    },
    "campaign_target": {
      "_comment": "캠페인 대상군 포함(발송 성공 여부 무관). 대상군 ⊇ 접촉 성공이므로 별칭에 '캠페인'·'발송' 같은 일반어를 넣지 않는다 — 접촉 요청을 가로채면 모집단이 조용히 넓어진다. 별칭 MT 와 조인 별칭 {alias}_ZC 는 campaign_contact_success 의 M/ZC 와 반드시 달라야 한다: 같으면 캠페인 단위 상관식이 ZC.x = ZC.x 항진명제로 무너지는데 별칭이 전부 허용목록에 있어 검증기가 통과시킨다. 회원 단위 판정임에 유의 — '캠페인 A 는 접촉 성공, B 는 미접촉'인 회원은 표현하지 못한다(캠페인별 의미는 CAMP_ID 조인 필드가 필요).",
      "table": "Z_CAMP_MBR",
      "alias": "MT",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MBR_NO",
      "time_column": "CAMP_SDATE",
      "time_format": "char8",
      "binding": "fact_table",
      "grain": "event",
      "from_sql": "Z_CAMP_MBR {alias} INNER JOIN Z_CAMPAIGN {alias}_ZC ON {alias}_ZC.CAMP_ID = {alias}.CAMP_ID AND {alias}_ZC.CAMP_EXEC_NO = {alias}.CAMP_EXEC_NO",
      "correlation_sql": "TRY_CAST({alias}.MBR_NO AS BIGINT) = {subject_alias}.{subject_key}",
      "group_subject_expression": "TRY_CAST({alias}.MBR_NO AS BIGINT)",
      "time_expression": "{alias}_ZC.CAMP_SDATE",
      "extra_predicates": [
        "{alias}.CELL_TYPE_CD = 'T'",
        "ISNULL({alias}_ZC.CANCEL_YN, 'N') = 'N'"
      ],
      "label": "캠페인 대상군 포함",
      "aliases": ["캠페인 대상군", "대상군에 포함", "캠페인 대상 고객군"]
    },
    "campaign_contact_success": {
      "table": "Z_CAMP_MBR",
      "alias": "M",
      "subject_key": "MEMBER_NO",
      "event_subject_key": "MBR_NO",
      "time_column": "CAMP_SDATE",
      "time_format": "char8",
      "binding": "fact_table",
      "grain": "event",
      "from_sql": "Z_CAMP_MBR {alias} INNER JOIN Z_CAMPAIGN ZC ON ZC.CAMP_ID = {alias}.CAMP_ID AND ZC.CAMP_EXEC_NO = {alias}.CAMP_EXEC_NO",
      "correlation_sql": "TRY_CAST({alias}.MBR_NO AS BIGINT) = {subject_alias}.{subject_key}",
      "group_subject_expression": "TRY_CAST({alias}.MBR_NO AS BIGINT)",
      "time_expression": "ZC.CAMP_SDATE",
      "extra_predicates": [
