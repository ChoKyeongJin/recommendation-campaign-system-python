      "markers": [
        "성별로",
        "성별 로",
        "성별마다",
        "성별 마다",
        "성별별",
        "남녀별",
        "남녀 별"
      ]
    },
    "age_group": {
      "group_expr": "__age_band__",
      "select_alias": "age_group",
      "coverage_token": "AGE",
      "include_null": false,
      "label": "연령대",
      "markers": [
        "연령대별",
        "연령대 별",
        "나이대별",
        "나이대 별",
        "연령별",
        "나이별",
        "세대별",
        "연령대마다",
        "나이대마다"
      ],
      "age_band": {
