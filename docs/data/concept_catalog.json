      "aliases": ["미구매", "무구매", "구매 안 한", "구매가 없는", "구매하지 않은", "구매 이력 없는", "안 산", "아무것도 안 산"],
      "kind": "special_slot",
      "entity_type": "slot",
      "data_type": "duration",
      "normalizer": "duration",
